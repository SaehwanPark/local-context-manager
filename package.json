{
  "name": "local-context-manager",
  "version": "0.1.0",
  "description": "A small Pi extension for cache-friendly local-LLM context control",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "local-llm", "context-management"],
  "license": "MIT",
  "files": ["src", "examples", "README.md"],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4 <1"
  },
  "dependencies": {
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
